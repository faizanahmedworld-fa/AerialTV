<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:shutter_background_color="@android:color/black"
        app:use_controller="false" />

    <!-- Tuning / loading -->
    <LinearLayout
        android:id="@+id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_banner"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="28dp"
        android:paddingEnd="36dp"
        android:paddingBottom="28dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="@style/Aerial.Text.Heading" />
    </LinearLayout>

    <!-- Problems (no internet, nothing playing) -->
    <LinearLayout
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_screen"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="48dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:id="@+id/messageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:maxWidth="560dp"
            android:textAppearance="@style/Aerial.Text.Title"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/retryButton"
                style="@style/Aerial.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:drawableStart="@drawable/ic_replay"
                android:text="@string/try_again" />

            <Button
                android:id="@+id/messageCountryButton"
                style="@style/Aerial.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:drawableStart="@drawable/ic_globe"
                android:text="@string/change_country" />

            <Button
                android:id="@+id/messageSettingsButton"
                style="@style/Aerial.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_settings"
                android:text="@string/settings" />
        </LinearLayout>
    </LinearLayout>

    <!-- Channel banner, shown when the channel changes -->
    <LinearLayout
        android:id="@+id/banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="40dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_banner"
        android:gravity="center_vertical"
        android:minWidth="440dp"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingTop="16dp"
        android:paddingEnd="26dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/bannerNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:minWidth="64dp"
            android:textColor="@color/accent"
            android:textSize="40sp" />

        <ImageView
            android:id="@+id/bannerLogo"
            android:layout_width="96dp"
            android:layout_height="66dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_logo_frame"
            android:importantForAccessibility="no"
            android:padding="6dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/bannerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="440dp"
                android:maxLines="1"
                android:textAppearance="@style/Aerial.Text.Title"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/bannerInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/Aerial.Text.Body"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/banner_hint"
                android:textAppearance="@style/Aerial.Text.Caption"
                android:textColor="@color/text_dim" />
        </LinearLayout>
    </LinearLayout>

    <!-- Number typed on the remote -->
    <TextView
        android:id="@+id/numberEntry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="40dp"
        android:background="@drawable/bg_banner"
        android:fontFamily="sans-serif-black"
        android:paddingStart="26dp"
        android:paddingTop="8dp"
        android:paddingEnd="26dp"
        android:paddingBottom="8dp"
        android:textColor="@color/accent"
        android:textSize="48sp"
        android:visibility="gone" />

    <!-- Channel list -->
    <FrameLayout
        android:id="@+id/guide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_guide"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/guidePanel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingStart="36dp"
            android:paddingTop="22dp"
            android:paddingEnd="24dp"
            android:paddingBottom="14dp">

            <!-- Categories -->
            <LinearLayout
                android:layout_width="@dimen/guide_categories_width"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="-8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_launcher_foreground" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textAppearance="@style/Aerial.Text.Title"
                        android:textColor="@color/accent"
                        android:textSize="20sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/guideCountry"
                    style="@style/Aerial.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:drawableStart="@drawable/ic_globe"
                    android:ellipsize="end"
                    android:gravity="center_vertical|start"
                    android:maxLines="1"
                    android:minHeight="46dp"
                    android:paddingStart="16dp"
                    android:textSize="16sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/categoryList"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="24dp" />
            </LinearLayout>

            <!-- Channels -->
            <LinearLayout
                android:layout_width="@dimen/guide_channels_width"
                android:layout_height="match_parent"
                android:layout_marginStart="18dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/guideSearch"
                        style="@style/Aerial.Search"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/search_hint"
                        android:importantForAutofill="no" />

                    <ImageButton
                        android:id="@+id/guideSettings"
                        style="@style/Aerial.IconButton"
                        android:layout_marginStart="10dp"
                        android:contentDescription="@string/settings"
                        android:src="@drawable/ic_settings" />
                </LinearLayout>

                <TextView
                    android:id="@+id/guideHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="2dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textAppearance="@style/Aerial.Text.Overline" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/channelList"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="24dp" />

                <TextView
                    android:id="@+id/guideEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textAppearance="@style/Aerial.Text.Body"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingStart="12dp"
                    android:text="@string/guide_hint"
                    android:textAppearance="@style/Aerial.Text.Caption" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:paddingStart="12dp"
                    android:text="@string/legal_note"
                    android:textAppearance="@style/Aerial.Text.Caption"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
