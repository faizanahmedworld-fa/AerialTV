<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:longClickable="true"
    android:minHeight="66dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="14dp">

    <TextView
        android:id="@+id/channelNumber"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textAppearance="@style/Aerial.Text.Number" />

    <ImageView
        android:id="@+id/channelLogo"
        android:layout_width="66dp"
        android:layout_height="46dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_logo_frame"
        android:importantForAccessibility="no"
        android:padding="4dp"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/channelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/Aerial.Text.Heading" />

        <TextView
            android:id="@+id/channelCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/Aerial.Text.Caption" />
    </LinearLayout>

    <ImageView
        android:id="@+id/channelPlaying"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_play"
        android:tint="@color/accent"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/channelFavorite"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_heart"
        android:tint="@color/accent"
        android:visibility="gone" />
</LinearLayout>
