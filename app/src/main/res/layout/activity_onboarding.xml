<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="36dp"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="28dp">

    <!-- Left: what this step is about -->
    <LinearLayout
        android:id="@+id/stepSide"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="40dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="-10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_launcher_foreground" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/Aerial.Text.Overline" />
        </LinearLayout>

        <TextView
            android:id="@+id/stepLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:textAppearance="@style/Aerial.Text.Caption" />

        <LinearLayout
            android:id="@+id/stepDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal" />

        <ImageView
            android:id="@+id/stepIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_icon_circle"
            android:importantForAccessibility="no"
            android:padding="13dp"
            android:tint="@color/accent" />

        <TextView
            android:id="@+id/stepTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:maxWidth="440dp"
            android:textAppearance="@style/Aerial.Text.Display" />

        <TextView
            android:id="@+id/stepSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxWidth="420dp"
            android:textAppearance="@style/Aerial.Text.Body" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="420dp"
            android:text="@string/legal_note"
            android:textAppearance="@style/Aerial.Text.Caption"
            android:textColor="@color/text_dim" />
    </LinearLayout>

    <!-- Right: the question -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/stepContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false">

            <!-- Country -->
            <LinearLayout
                android:id="@+id/stepCountry"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/countrySearch"
                    style="@style/Aerial.Search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/search_countries"
                    android:importantForAutofill="no" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/countryList"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="24dp" />
            </LinearLayout>

            <!-- Who's watching -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/stepProfile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:visibility="gone" />

            <!-- Interests -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/stepInterests"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:visibility="gone" />

            <!-- Languages -->
            <LinearLayout
                android:id="@+id/stepLanguages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/languageSearch"
                        style="@style/Aerial.Search"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/search_languages"
                        android:importantForAutofill="no" />

                    <TextView
                        android:id="@+id/languageCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:background="@drawable/bg_badge"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:textAppearance="@style/Aerial.Text.Label"
                        android:textColor="@color/on_accent"
                        android:textSize="13sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/languageList"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="24dp" />
            </LinearLayout>

            <!-- Done -->
            <LinearLayout
                android:id="@+id/stepDone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_country"
                    android:textAppearance="@style/Aerial.Text.Overline" />

                <TextView
                    android:id="@+id/summaryCountry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Aerial.Text.Heading" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/settings_profile"
                    android:textAppearance="@style/Aerial.Text.Overline" />

                <TextView
                    android:id="@+id/summaryProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Aerial.Text.Heading" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/settings_interests"
                    android:textAppearance="@style/Aerial.Text.Overline" />

                <TextView
                    android:id="@+id/summaryInterests"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Aerial.Text.Heading" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/settings_languages"
                    android:textAppearance="@style/Aerial.Text.Overline" />

                <TextView
                    android:id="@+id/summaryLanguages"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Aerial.Text.Heading" />
            </LinearLayout>
        </FrameLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/skipButton"
                style="@style/Aerial.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="@string/skip" />

            <Button
                android:id="@+id/nextButton"
                style="@style/Aerial.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableEnd="@drawable/ic_arrow_forward"
                android:text="@string/next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
