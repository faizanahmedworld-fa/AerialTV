<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="36dp"
    android:paddingEnd="@dimen/screen_padding">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="40dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="-10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_launcher_foreground" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/Aerial.Text.Overline" />
        </LinearLayout>

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_icon_circle"
            android:importantForAccessibility="no"
            android:padding="13dp"
            android:src="@drawable/ic_settings"
            android:tint="@color/accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/settings"
            android:textAppearance="@style/Aerial.Text.Display" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxWidth="420dp"
            android:text="@string/settings_subtitle"
            android:textAppearance="@style/Aerial.Text.Body" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:maxWidth="420dp"
            android:text="@string/legal_note"
            android:textAppearance="@style/Aerial.Text.Caption"
            android:textColor="@color/text_dim" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/settingsList"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:clipToPadding="false"
        android:paddingBottom="36dp" />
</LinearLayout>
